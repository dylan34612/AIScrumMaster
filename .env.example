# LLM
# Point at any OpenAI-compatible or Azure OpenAI endpoint.

LLM_API_BASE=https://YOUR_RESOURCE.openai.azure.com/

LLM_API_KEY=

# Recommended for local Entra-backed proxies: browser (interactive user login).
# Alternatives: azure_ad (service principal) or api_key.
LLM_AUTH_MODE=browser

LLM_MODEL=gpt-4o

LLM_API_VERSION=2024-10-21

LLM_TEMPERATURE=0.2

LLM_MAX_TOOL_STEPS=6

LLM_SCHEMA_REPAIR_MAX_ATTEMPTS=3



# Shared Azure AD / Entra tenant (browser and service principal).

LLM_AZURE_TENANT_ID=



# Browser / interactive user auth (LLM_AUTH_MODE=browser).
# Use the Entra app registration that allows interactive login to your LLM proxy.

LLM_AZURE_USER_CLIENT_ID=

LLM_AZURE_USER_AUDIENCE=

# After setting LLM_AUTH_MODE=browser, run: python -m agenticscrum login



# Service principal auth (LLM_AUTH_MODE=azure_ad).

LLM_AZURE_CLIENT_ID=

LLM_AZURE_CLIENT_SECRET=

LLM_AZURE_AUDIENCE=



# Azure DevOps

ADO_ORG=YourOrg

ADO_PROJECT=Your Project

ADO_TEAM=Your Team

ADO_AREA_PATH=Your Project\Your Team

ADO_PAT=

ADO_CATALOG_LOOKBACK_DAYS=60

ADO_STORY_POINTS_FIELD=Microsoft.VSTS.Scheduling.StoryPoints

ADO_EFFORT_FIELD=Microsoft.VSTS.Scheduling.Effort

ADO_ESTIMATION_MODE=auto

ADO_STORY_POINTS_SCALE=1,2,3,5,8,13

ADO_EFFORT_SCALE=1,2,3,5,8,13

ADO_EFFORT_UNIT=hours



# Notes inbox

NOTES_INBOX_ENABLED=true

NOTES_INBOX_PATH=./data/notes_inbox

NOTES_INBOX_ARCHIVE_PATH=./data/notes_inbox_archive

# archive: move processed files to archive; delete: remove; keep: leave in place (dedupe by content hash)

NOTES_INBOX_ARCHIVE_MODE=archive

NOTES_INBOX_EXTENSIONS=.md,.txt,.vtt,.docx

# Avoid ingesting a file while it's still being written.

NOTES_INBOX_MIN_AGE_SECONDS=30



# App

APP_HOST=127.0.0.1

APP_PORT=8765

APP_DB_PATH=./data/agenticscrum.db

APP_INGEST_LOOKBACK_HOURS=26

APP_DAILY_RUN_TIME=00:00

APP_DAILY_REVIEW_TIME=08:30

APP_DAILY_REVIEW_ENABLED=true

APP_DAILY_REVIEW_STALE_DAYS=14

APP_DAILY_REVIEW_MAX_ITEMS=80

APP_DAILY_REVIEW_MAX_COMMENT_ITEMS=25

APP_TIMEZONE=America/New_York

APP_APPROVAL_POLL_MINUTES=360

APP_APPROVER_NAME=Approver

# If true, retry failed ADO applies once by auto-revising the payload.

APP_AUTO_FIX_ERRORS=true

APP_AGENTIC_RETRY_MAX_LOOPS=3



# Autopilot (optional): periodically ingest inbox + auto-apply safe proposals.

# Default is off; enable only when you're comfortable with the guardrails.

APP_AUTOPILOT_ENABLED=false

APP_AUTOPILOT_POLL_MINUTES=5

APP_AUTOPILOT_INGEST_INBOX=true

APP_AUTOPILOT_CONFIDENCE_THRESHOLD=90

APP_AUTOPILOT_MAX_APPLY_PER_CYCLE=10

APP_AUTOPILOT_APPROVER_NAME=Autopilot

APP_AUTOPILOT_ALLOW_ASSIGN=true

APP_AUTOPILOT_ALLOW_STATE_TRANSITIONS=true

APP_AUTOPILOT_ALLOW_COMMENTS=true

APP_AUTOPILOT_COMMENT_MIN_CONFIDENCE=95



# Automatic proposal judge/refine (recommended): evaluates every pending proposal

# with a second-pass reviewer and can iteratively refine low-quality proposals.

APP_AUTO_JUDGE_ENABLED=true

APP_AUTO_REFINE_ENABLED=true

APP_AUTO_REFINE_MAX_LOOPS=2
